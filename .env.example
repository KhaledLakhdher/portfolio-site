# Copy this file to ".env" and put your key there (".env" is gitignored).
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.
# NEVER put a real key in THIS file (.env.example is committed).

# Your OpenRouter API key (https://openrouter.ai/keys). Starts with "sk-or-...".
OPENROUTER_API_KEY=

# A CHAT / INSTRUCT model (not a safety/embedding model). Current free options:
#   openai/gpt-oss-20b:free                  (fast, follows instructions well — default)
#   openai/gpt-oss-120b:free                 (stronger, free)
#   meta-llama/llama-3.3-70b-instruct:free   (free, sometimes rate-limited)
# Paid but very cheap & reliable: openai/gpt-4o-mini
# Browse models at https://openrouter.ai/models  (filter: Free + Chat)
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Your deployed site URL (used for OpenRouter attribution headers). Optional.
SITE_URL=http://localhost:5173
